# Normalize text files
* text=auto

# Source code and configuration
*.java       text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.jsx        text eol=lf
*.json       text eol=lf
*.txt        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.properties text eol=lf
*.xml        text eol=lf
*.md         text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.env.example text eol=lf

# Linux / Unix scripts
*.sh         text eol=lf
mvnw         text eol=lf

# Windows scripts
*.bat        text eol=crlf
*.cmd        text eol=crlf
mvnw.cmd     text eol=crlf

# Binary files
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.pdf        binary
COMPOSE_PROJECT_NAME=minishop

# =========================
# Docker host ports
# =========================
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
QDRANT_HOST_PORT=6333
SPRING_HOST_PORT=8080
FASTAPI_HOST_PORT=8000
REACT_HOST_PORT=5173

# =========================
# MySQL
# =========================
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=minishop
MYSQL_USER=minishop
MYSQL_PASSWORD=

# =========================
# Docker volumes
# =========================
MYSQL_VOLUME=minishop-mysql-data
REDIS_VOLUME=minishop-redis-data
QDRANT_VOLUME=minishop-qdrant-data

# =========================
# Frontend build
# =========================
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# =========================
# Spring Boot database
# =========================
DB_URL=jdbc:mysql://mysql:3306/minishop
DB_USERNAME=minishop
DB_PASSWORD=

# =========================
# Redis - Docker network
# =========================
REDIS_HOST=redis
REDIS_PORT=6379

# =========================
# Qdrant - Docker network
# =========================
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=products
QDRANT_API_KEY=
QDRANT_HTTPS=false
# =========================
# AI Service
# =========================
AI_SERVICE_URL=http://ai:8000